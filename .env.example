# Copiar para .env.local (desenvolvimento) e definir no painel da Vercel
# (produção). Os ficheiros .env são lidos da RAIZ do projeto, nunca de src/.
#
# Este ficheiro é a lista completa das variáveis do projeto: é aqui que se vê,
# sem ler código, o que é preciso definir. O site público precisa só da
# primeira; as outras são do painel (/painel) e são segredos — na Vercel,
# marcadas como Sensitive. O `npm run build` corre sem nenhuma delas.

# Endereço público do site, sem barra no fim. Fonte única do domínio: alimenta
# o metadataBase (imagens de partilha), o sitemap.xml, o robots.txt e os dados
# estruturados. Ver src/lib/site.ts.
# Sem ela assume-se o subdomínio de demonstração da Vercel.
NEXT_PUBLIC_SITE_URL=

# ============================================================== O PAINEL ===
# Ver docs/PAINEL.md. Mudar uma destas na Vercel pede um redeploy.

# Quem entra, separados por vírgulas. Não há password: quem está aqui recebe um
# código por email. Endereços individuais, nunca um geral@.
PAINEL_EMAILS=

# O envio do código. Conta e domínio da agência — o domínio tem de ser, à letra,
# o que está como Verified no Resend (send.devplus.pt, e não devplus.pt).
# Em desenvolvimento, sem chave, o código sai no terminal do `npm run dev`.
RESEND_API_KEY=
RESEND_REMETENTE=Painel do Preguiça <noreply@send.devplus.pt>

# O token que grava no repositório. Fine-grained, resource owner DEVV-TGR, só
# o Cafe-Preguica, Contents: Read and write. Caduca ao fim de um ano, no máximo.
PAINEL_GITHUB_TOKEN=

# Só em desenvolvimento: a branch onde o painel lê e grava, para experimentar
# sem tocar no site verdadeiro. Tem de existir no GitHub. Em produção é
# ignorada — grava-se sempre no main.
PAINEL_GITHUB_RAMO=

# Os contadores de tentativas e os aparelhos lembrados. A integração do Upstash
# na Vercel injeta estas duas sozinha. Sem elas, em produção o painel não abre;
# em desenvolvimento os contadores ficam na memória, com um aviso.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ========================================================== A NEWSLETTER ===
# Ver docs/NEWSLETTER.md. Três variáveis próprias, separadas das do painel, para
# a newsletter poder mudar de conta do Resend (da agência para a da casa) sem
# tocar em código — e para nunca gastar a quota dos códigos de entrada.
#
# Em desenvolvimento, sem chave, o link de confirmação sai no terminal do
# `npm run dev` e o ecrã do painel diz que o envio não está ligado.

# A chave da conta onde vivem os contactos. Em testes, a da agência.
RESEND_NEWSLETTER_API_KEY=

# O remetente, num domínio verificado nessa conta, à letra.
RESEND_NEWSLETTER_REMETENTE=Café Preguiça <novidades@send.devplus.pt>

# O id do segmento (Resend → Audience → Segments → o segmento → copiar o id).
RESEND_NEWSLETTER_SEGMENTO=
