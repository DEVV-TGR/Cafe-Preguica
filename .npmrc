# Nenhum pacote corre scripts de instalação (postinstall e afins) — a mesma
# decisão do `allowScripts` do package.json, mas aplicada por qualquer npm.
# O `allowScripts` só é lido a partir do npm 11; o Node 22 do CI traz o npm 10,
# que o ignora e corria os três scripts que essa lista diz bloqueados.
# Verificado: `npm ci` e `npm run build` com o npm 10.9.9 e com o npm 12.
# Os `npm run <script>` do projeto continuam a correr (só os pre/post não).
ignore-scripts=true
